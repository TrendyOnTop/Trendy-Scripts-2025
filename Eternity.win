-- Update Content Size
local function UpdateContentSize(Tab)
    local YSize = 0
    for _, child in ipairs(Tab:GetChildren()) do
        if child:IsA("Frame") and child.Size.Y.Offset > 0 then
            YSize = YSize + child.Size.Y.Offset + 5
        end
    end
    Tab.Size = UDim2.new(1, 0, 0, YSize)
    ContentFrame.CanvasSize = UDim2.new(0, 0, 0, YSize)
end

