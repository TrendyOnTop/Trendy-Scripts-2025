    UIButton = Instance.new("TextButton")
    UIButton.Name = "ToggleButton"
    UIButton.Size = UDim2.new(0, 60, 0, 60)
    UIButton.Position = UDim2.new(1, -70, 0, 10)
    UIButton.BackgroundColor3 = Color3.fromRGB(20, 0, 0)
    UIButton.BackgroundTransparency = 0.3
    UIButton.BorderSizePixel = 2
    UIButton.BorderColor3 = Color3.fromRGB(255, 0, 0)
